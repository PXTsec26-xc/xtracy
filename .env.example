# XTRACY Environment Configuration

# Platform Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Live Threat Intelligence Feeds
CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
CACHE_TTL_SECONDS=3600

# Backend Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Database Configuration (Optional for Local Development / Required for PostgreSQL Production)
# DATABASE_URL=postgresql://user:password@localhost:5432/xtracy_db

# Authentication Provider Secrets
AUTH_SECRET=xtracy_super_secret_jwt_key_change_in_production

# Optional: XTRACY AI Provider API Keys
# When left unset, XTRACY AI operates in transparent Standby Mode with the built-in defensive rule engine.
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: External Reputation Provider Keys for URL Guard
# When left unset, URL Guard operates with deep deterministic heuristic & structural analysis.
# VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
# SAFE_BROWSING_API_KEY=your_google_safe_browsing_key_here
