# XTRACY Environment Configuration Example

# Platform Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Live Threat Intelligence Sources
CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
CACHE_TTL_SECONDS=3600

# Backend Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Database Configuration (Optional for Development / Required for Production)
# DATABASE_URL=postgresql://user:password@localhost:5432/xtracy_db

# Authentication Provider Secrets (Optional for Development Fallback / Required for Production)
AUTH_SECRET=xtracy_super_secret_jwt_key_change_in_production
# NEXTAUTH_SECRET=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# CLERK_SECRET_KEY=
